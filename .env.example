# Copy to .env and adjust. Used by Next.js and drizzle-kit.
POSTGRES_USER=spidersense
POSTGRES_PASSWORD=spidersense
POSTGRES_DB=spidersense
POSTGRES_PORT=5433
DATABASE_URL=postgres://spidersense:spidersense@localhost:5433/spidersense

# Links in emails point here.
APP_URL=http://localhost:3000

# SMTP server for outgoing mail. In development, Mailpit (npm run services:up)
# catches every mail: read them on http://localhost:8025.
# Without SMTP_URL, mails are stored in the database and shown on /dev/mails.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Spider Sense <no-reply@spider-sense.test>"
# Mailpit UI, linked from the sign-up and password pages (development only).
MAILPIT_URL=http://localhost:8025
